# Stardew Valley Companion - Environment Configuration

# Path to your Stardew Valley game installation
# Used by DataExporter/build-data-exporter.sh to build and install the SMAPI mod
# Example (Windows): STARDEW_GAME_DIR="C:/Program Files (x86)/Steam/steamapps/common/Stardew Valley"
# Example (Linux): STARDEW_GAME_DIR="/home/user/.steam/steam/steamapps/common/Stardew Valley"
# Example (Mac): STARDEW_GAME_DIR="/Users/user/Library/Application Support/Steam/steamapps/common/Stardew Valley"
STARDEW_GAME_DIR="/path/to/Stardew Valley"

# Path to .NET SDK (optional, will auto-detect if not set)
# Only needed if dotnet is not in your PATH
# Example: DOTNET_PATH="/home/user/.dotnet/dotnet"
# DOTNET_PATH=""
